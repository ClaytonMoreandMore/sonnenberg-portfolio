---
import Base from '../layouts/Base.astro';
---
<Base title="404 — Gabriel Sonnenberg">
  <div style="min-height:100vh;display:grid;place-items:center;padding:var(--px)">
    <div style="text-align:center">
      <span style="font-family:var(--font-mono);font-size:11px;color:var(--accent);letter-spacing:.08em">ERROR 404</span>
      <h1 style="margin-top:8px;font-size:clamp(32px,5vw,64px);font-weight:500;letter-spacing:-.02em">Page not found</h1>
      <a href="/" style="display:inline-block;margin-top:20px;font-size:15px;color:var(--muted)">&larr; Back to reel</a>
    </div>
  </div>
</Base>
