---
import Base from '../layouts/Base.astro';
import { PROJECTS, REEL_ID, YT_CHANNEL, EDITS, EMAIL, LINKEDIN, INSTAGRAM } from '../data/projects';

const ytEmbed = (id: string, params: string) =>
  `https://www.youtube-nocookie.com/embed/${id}?${params}`;

const reelPlaySrc = ytEmbed(REEL_ID, 'autoplay=1&rel=0&modestbranding=1&playsinline=1');

const pad = (n: number) => String(n).padStart(2, '0');
---
<Base title="Gabriel Sonnenberg — VFX Generalist / Compositor">

<div style="min-height:100vh;display:flex;flex-direction:column">

<!-- Header -->
<header style="position:sticky;top:0;z-index:10;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:16px var(--px);background:rgba(11,11,12,.82);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)">
  <a href="#top" style="font-weight:600;font-size:14px;letter-spacing:.02em">GABRIEL SONNENBERG</a>
  <nav style="display:flex;gap:clamp(14px,3vw,28px);font-size:13px;color:var(--muted)">
    <a href="#work" style="color:inherit">Work</a>
    <a href="#editing" style="color:inherit">Editing</a>
    <a href="#about" style="color:inherit">About</a>
    <a href="#contact" style="color:inherit">Contact</a>
  </nav>
</header>

<!-- Hero -->
<section id="top" style="padding:clamp(28px,5vw,64px) var(--px) clamp(32px,5vw,56px);display:grid;gap:clamp(20px,3vw,36px)">
  <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:16px">
    <div>
      <h1 style="font-size:clamp(34px,6vw,76px);font-weight:500;line-height:.98;letter-spacing:-.02em">Gabriel Sonnenberg</h1>
      <p style="margin-top:12px;font-size:clamp(15px,1.6vw,20px);color:var(--muted)">VFX Generalist <span style="color:var(--accent)">/</span> Compositor</p>
    </div>
    <div style="font-family:var(--font-mono);font-size:12px;color:var(--dim);display:grid;gap:4px;text-align:right">
      <span>DEMO REEL &middot; 2026</span>
    </div>
  </div>
  <div class="facade" data-facade data-video-src={reelPlaySrc} style="aspect-ratio:16/9">
    <img src={`https://img.youtube.com/vi/${REEL_ID}/maxresdefault.jpg`} alt="Demo reel thumbnail" />
    <div class="play-btn"><svg viewBox="0 0 48 48"><path d="M16 10v28l22-14z"/></svg></div>
  </div>
  <div style="display:flex;flex-wrap:wrap;gap:8px 24px;font-family:var(--font-mono);font-size:11px;color:var(--dim);text-transform:uppercase;letter-spacing:.06em">
    <span>Red Deer Polytechnic &middot; BAA Animation &amp; VFX &middot; 2026</span>
    <span>Nuke &middot; Maya &middot; Unreal &middot; Premiere &middot; Photoshop</span>
    <span>Open to junior comp / generalist roles</span>
  </div>
</section>

<!-- Selected works -->
<section id="work" class="fade-section" style="padding:clamp(24px,4vw,56px) var(--px);border-top:1px solid var(--line);display:grid;gap:clamp(18px,3vw,32px)">
  <h2 style="font-size:clamp(20px,2.4vw,28px);font-weight:500;letter-spacing:-.01em">Selected works</h2>
  <div class="works-grid">
    {PROJECTS.map((p, i) => (
      <div class="project-card" data-slug={p.slug}>
        <div class="project-thumb" data-expand>
          <img src={`https://img.youtube.com/vi/${p.video}/maxresdefault.jpg`} alt={p.title} loading={i === 0 ? 'eager' : 'lazy'} />
        </div>
        <div class="card-info">
          <div>
            <a href={`/work/${p.slug}/`} style="font-size:17px;font-weight:500;color:inherit">{p.title} <span style="color:var(--accent)">&rarr;</span></a>
            <div style="font-size:13px;color:var(--muted);margin-top:2px">{p.sub}</div>
          </div>
          <span style="font-family:var(--font-mono);font-size:11px;color:var(--dim);white-space:nowrap">{p.year}</span>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- Video editing -->
<section id="editing" class="fade-section" style="padding:clamp(24px,4vw,56px) var(--px);border-top:1px solid var(--line);display:grid;gap:clamp(18px,3vw,32px)">
  <div class="section-head">
    <div>
      <h2 style="font-size:clamp(20px,2.4vw,28px);font-weight:500;letter-spacing:-.01em">Video editing</h2>
      <p style="margin-top:6px;font-size:14px;color:var(--muted);max-width:60ch">Edits and thumbnails for my YouTube channel, ChiliDog. Cut in Premiere Pro, thumbnails in Photoshop.</p>
    </div>
    <a href={YT_CHANNEL} target="_blank" rel="noopener" style="font-family:var(--font-mono);font-size:11px;color:var(--muted)">YOUTUBE CHANNEL &#8599;</a>
  </div>
  <div class="works-grid">
    {EDITS.map((e, i) => (
      <div class="project-card">
        <div class="project-thumb" data-expand>
          <img src={`https://img.youtube.com/vi/${e.video}/maxresdefault.jpg`} alt={e.title} loading="lazy" />
          <div class="play-btn"><svg viewBox="0 0 48 48"><path d="M16 10v28l22-14z"/></svg></div>
        </div>
        <div style="padding:10px 2px 0">
          <div style="font-size:15px;font-weight:500">{e.title}</div>
        </div>
        <div class="edit-player" style="display:none">
          <div class="video-wrap">
            <iframe
              referrerpolicy="strict-origin-when-cross-origin"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
              data-play-src={ytEmbed(e.video, 'rel=0&modestbranding=1&playsinline=1&autoplay=1')}
            ></iframe>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- About -->
<section id="about" class="fade-section" style="padding:clamp(32px,5vw,72px) var(--px);border-top:1px solid var(--line);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:clamp(20px,4vw,48px);align-items:start">
  <div>
    <h2 style="margin-bottom:clamp(16px,2vw,24px);font-size:clamp(20px,2.4vw,28px);font-weight:500;letter-spacing:-.01em">About</h2>
    <img src="/headshot.jpg" alt="Gabriel Sonnenberg" class="headshot" />
  </div>
  <div style="font-size:clamp(16px,1.5vw,19px);line-height:1.55;color:var(--text-2);max-width:62ch;display:grid;gap:18px">
    <p>I'm a VFX generalist focused on compositing: integrating CG into live-action footage until the seams disappear. My day-to-day is Nuke and Maya, covering camera tracking, matchmoving, rotoscoping, green screen keying, matte painting and colour correction.</p>
    <p>I graduated with honours from Red Deer Polytechnic's Bachelor of Applied Arts in Animation and Visual Effects in April 2026, on the Dean's List every term. At RDP I worked in a 15-person team on the Sports Animation Project, a simulated studio pipeline, and animated shorts for the RDP sports committee.</p>
    <p>Outside school I've done 3D modelling, rendering and graphic design for the U of A Engineers in Action club, logo and 3D promo work for a Twitch streamer, and I edit and design thumbnails for my own YouTube channel, ChiliDog.</p>
    <p>Before VFX I spent five years supervising lifeguard teams for the City of Red Deer, Town of Blackfalds and City of Edmonton, which is where I learned to stay calm, run a team and hold a standard under pressure.</p>
  </div>
</section>

<!-- Contact -->
<section id="contact" class="fade-section" style="padding:clamp(32px,5vw,72px) var(--px) clamp(40px,6vw,80px);border-top:1px solid var(--line);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:clamp(20px,4vw,48px);align-items:start">
  <div>
    <h2 style="margin-bottom:6px;font-size:clamp(20px,2.4vw,28px);font-weight:500;letter-spacing:-.01em">Contact</h2>
    <span class="mono">STUDIO ROLES &middot; FREELANCE</span>
  </div>
  <div style="display:grid;font-size:clamp(16px,1.5vw,19px)">
    <a href={`mailto:${EMAIL}`} class="contact-row">
      <span class="contact-label"><svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 4 10 8 10-8"/></svg>Email</span><span style="color:var(--muted)">{EMAIL}</span>
    </a>
    <a href={INSTAGRAM} target="_blank" rel="noopener" class="contact-row">
      <span class="contact-label"><svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>Instagram</span><span style="color:var(--muted)">@chilidog_studios</span>
    </a>
    <a href={LINKEDIN} target="_blank" rel="noopener" class="contact-row">
      <span class="contact-label"><svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="3"/><path d="M7 11v6M7 7v.01M11 11v6m0-3a3 3 0 0 1 6 0v3"/></svg>LinkedIn</span><span style="color:var(--muted)">gabriel-sonnenberg</span>
    </a>
    <a href="/Gabriel_Sonnenberg_Resume.pdf" download="Gabriel_Sonnenberg_Resume.pdf" class="contact-row" style="border-bottom:1px solid var(--line)">
      <span class="contact-label"><svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><polyline points="9 15 12 18 15 15"/></svg>Resume</span><span style="color:var(--accent)">PDF &#8595;</span>
    </a>
  </div>
</section>

<!-- Footer -->
<footer style="margin-top:auto;padding:20px var(--px);display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px;font-family:var(--font-mono);font-size:11px;color:var(--faint)">
  <span>&copy; 2026 GABRIEL SONNENBERG</span>
</footer>

</div>

</Base>

<style>
  .works-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: clamp(12px, 2vw, 20px);
  }

  .project-card {
    display: block;
    color: inherit;
  }
  .project-card.expanded {
    grid-column: 1 / -1;
  }
  .project-card .card-info {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding: 14px 2px 0;
  }
  .project-thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--surface);
    border: 1px solid var(--line);
    overflow: hidden;
    cursor: pointer;
  }
  .project-thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .3s ease;
  }
  .project-card:hover .project-thumb img {
    transform: scale(1.04);
  }
  .project-card.expanded .project-thumb {
    border-color: var(--accent);
  }

  .headshot {
    margin-top: clamp(16px, 2vw, 24px);
    width: 100%;
    border: 1px solid var(--line);
  }

  .contact-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 14px 0;
    border-top: 1px solid var(--line);
    color: inherit;
  }
  .contact-label {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .contact-icon {
    width: 20px;
    height: 20px;
    color: var(--muted);
    flex-shrink: 0;
  }
  .contact-row:hover .contact-icon {
    color: var(--accent);
  }
</style>

<script>
  // Expand/collapse cards in each works-grid independently
  document.querySelectorAll('.works-grid').forEach(grid => {
    grid.querySelectorAll<HTMLElement>('[data-expand]').forEach(thumb => {
      thumb.addEventListener('click', () => {
        const card = thumb.closest('.project-card') as HTMLElement;
        const wasExpanded = card.classList.contains('expanded');

        // Collapse all in this grid and stop any playing videos
        grid.querySelectorAll('.project-card.expanded').forEach(c => {
          c.classList.remove('expanded');
          const player = c.querySelector('.edit-player') as HTMLElement | null;
          if (player) {
            player.style.display = 'none';
            const iframe = player.querySelector('iframe');
            if (iframe) iframe.removeAttribute('src');
          }
        });

        // Toggle clicked card
        if (!wasExpanded) {
          card.classList.add('expanded');

          // If it has a player (editing section), show it and start playback
          const player = card.querySelector('.edit-player') as HTMLElement | null;
          if (player) {
            player.style.display = 'block';
            const iframe = player.querySelector('iframe');
            if (iframe && iframe.dataset.playSrc) {
              iframe.src = iframe.dataset.playSrc;
            }
          }

          card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });
    });
  });

  // Click-to-play facade (hero reel only)
  document.querySelectorAll<HTMLElement>('[data-facade]').forEach(el => {
    el.addEventListener('click', () => {
      const src = el.dataset.videoSrc;
      if (!src) return;
      const iframe = document.createElement('iframe');
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.allow = 'autoplay; fullscreen; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.src = src;
      iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;z-index:2';
      el.innerHTML = '';
      el.style.cursor = 'default';
      el.appendChild(iframe);
    }, { once: true });
  });

  // Scroll fade-in
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); } });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-section').forEach(s => io.observe(s));
</script>
